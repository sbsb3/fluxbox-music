# Fluxbox music-production panel (normal, 56px / 24px icons)
# Compact profile: fluxbox-music-compact.tint2rc (Fluxbox menu → Panel).
# Panel stays opaque; picom is only for ARGB docks (Plank).

# Background 1: Panel
rounded = 0
border_width = 0
border_sides = TBLR
background_color = #0b0b0d 100
border_color = #222222 100
background_color_hover = #0b0b0d 100
border_color_hover = #222222 100
background_color_pressed = #0b0b0d 100
border_color_pressed = #222222 100

# Background 2: Default task
rounded = 0
border_width = 0
border_sides = TBLR
background_color = #0b0b0d 100
border_color = #0b0b0d 100
background_color_hover = #1a1a1a 100
border_color_hover = #1a1a1a 100
background_color_pressed = #222222 100
border_color_pressed = #222222 100

# Background 3: Active task
rounded = 0
border_width = 0
border_sides = B
background_color = #161616 100
border_color = #888888 100
background_color_hover = #1c1c1c 100
border_color_hover = #888888 100
background_color_pressed = #222222 100
border_color_pressed = #888888 100

# Background 4: Urgent task
rounded = 0
border_width = 0
border_sides = TBLR
background_color = #3a2200 100
border_color = #aa7733 100
background_color_hover = #3a2200 100
border_color_hover = #aa7733 100
background_color_pressed = #3a2200 100
border_color_pressed = #aa7733 100

# Background 5: Tooltip
rounded = 0
border_width = 1
border_sides = TBLR
background_color = #111111 100
border_color = #333333 100
background_color_hover = #111111 100
border_color_hover = #333333 100
background_color_pressed = #111111 100
border_color_pressed = #333333 100

# Background 6: Inactive desktop name
rounded = 0
border_width = 0
border_sides = TBLR
background_color = #0b0b0d 100
border_color = #0b0b0d 100
background_color_hover = #1a1a1a 100
border_color_hover = #1a1a1a 100
background_color_pressed = #1a1a1a 100
border_color_pressed = #1a1a1a 100

# Background 7: Active desktop name
rounded = 0
border_width = 0
border_sides = B
background_color = #161616 100
border_color = #888888 100
background_color_hover = #161616 100
border_color_hover = #888888 100
background_color_pressed = #161616 100
border_color_pressed = #888888 100

# Panel
# L launcher, T tasks, E workspace buttons, S tray, C clock
panel_items = LTEESC
panel_size = 100% 56
panel_margin = 0 0
panel_padding = 4 2 4
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_position = top center horizontal
panel_layer = top
panel_monitor = primary
panel_shrink = 0
autohide = 0
autohide_show_timeout = 0
autohide_hide_timeout = 0.5
autohide_height = 2
# gap #8 (openbox-port-plan.md) / PORT-NOTES.md: Fluxbox reserved this space
# itself via session.screen0.struts.1 (a per-head override tint2's own
# strut_policy=follow_size could not express on this L-shaped 3-head layout,
# where "follow_size" reserves from the virtual screen edge rather than the
# primary monitor's edge). Openbox's rc.xml has no per-head equivalent to
# struts.N at all -- only a single whole-desktop <margins> -- so there is no
# WM-side fallback here if this does not land correctly. panel_monitor is
# already pinned to primary above, which should give follow_size a correct
# _NET_WM_STRUT_PARTIAL start/end range for that head; NOT YET VERIFIED on
# the real 3-monitor layout (only single-monitor-tested, where it publishes
# a strut and moves _NET_WORKAREA as expected). If maximized windows still
# tuck under the panel wrong, or overlap on the wrong head, try
# panel_pivot_struts = 1 next; if neither works, fall back to
# strut_policy = none and accept the panel visually overlapping maximized
# windows as a known regression (harmless since tint2 stays layer=above).
strut_policy = follow_size
panel_window_name = tint2
disable_transparency = 1
mouse_effects = 1
font_shadow = 0
mouse_hover_icon_asb = 100 0 10
mouse_pressed_icon_asb = 100 0 0

# Taskbar
# multi_desktop + hide_different_desktop keeps only the current workspace's
# tasks visible (same look as single_desktop) but re-evaluates visibility on
# every desktop change. single_desktop can stick on Internet's task list when
# a workarea/geometry PropertyNotify makes tint2 re-read _NET_CURRENT_DESKTOP
# as 0 (notifications and workspace switches both trigger that path).
taskbar_mode = multi_desktop
taskbar_hide_if_empty = 1
taskbar_padding = 0 0 4
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
taskbar_hide_inactive_tasks = 0
taskbar_hide_different_monitor = 0
taskbar_hide_different_desktop = 1
taskbar_always_show_all_desktop_tasks = 0
taskbar_name_padding = 8 4
taskbar_name_background_id = 6
taskbar_name_active_background_id = 7
taskbar_name_font = sans bold 9
taskbar_name_font_color = #888888 100
taskbar_name_active_font_color = #eeeeee 100
taskbar_distribute_size = 1
taskbar_sort_order = none
task_align = left

# Task
task_text = 1
task_icon = 1
task_centered = 0
urgent_nb_of_blink = 8
task_maximum_size = 200 56
task_padding = 8 4 4
task_font = sans 9
task_tooltip = 1
task_font_color = #dddddd 100
task_icon_asb = 100 0 0
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 4
task_iconified_background_id = 2
mouse_left = toggle_iconify
mouse_middle = close
# Right-click on a task is handled by ~/.openbox-music/task-menu.py (Send To /
# iconify / maximize / close). none + wm_menu would only forward to
# Fluxbox, which does not open WindowMenu from the panel.
mouse_right = none
mouse_scroll_up = prev_task
mouse_scroll_down = next_task

# System tray
systray_padding = 0 0 4
systray_background_id = 0
systray_sort = right2left
systray_icon_size = 24
systray_icon_asb = 100 0 0
systray_monitor = primary
systray_name_filter =

# Launcher
launcher_padding = 0 0 4
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_icon_size = 24
launcher_icon_asb = 100 0 0
launcher_icon_theme = Adwaita-Red
launcher_icon_theme_override = 1
startup_notifications = 0
launcher_tooltip = 1
launcher_item_app = /home/sb/.openbox-music/launchers/music-menu.desktop
launcher_item_app = /usr/share/applications/sunvox.desktop
launcher_item_app = /usr/share/applications/renoise.desktop
launcher_item_app = /usr/share/applications/com.bitwig.BitwigStudio.desktop
launcher_item_app = /usr/share/applications/carla.desktop
launcher_item_app = /usr/share/applications/org.rncbc.qpwgraph.desktop
launcher_item_app = /usr/share/applications/pcmanfm.desktop
launcher_item_app = /usr/share/applications/org.wezfurlong.wezterm.desktop

# Workspace switcher (left of tray and clock): Internet, Audio
execp = new
execp_command = /home/sb/.openbox-music/workspace-switch.sh show 0
execp_interval = 1
execp_has_icon = 0
execp_cache_icon = 1
execp_continuous = 0
execp_markup = 1
execp_tooltip = Workspace
execp_font = sans 9
execp_font_color = #888888 100
execp_padding = 8 4
execp_background_id = 0
execp_centered = 1
execp_lclick_command = /home/sb/.openbox-music/workspace-switch.sh goto 0
execp_uwheel_command = /home/sb/.openbox-music/workspace-switch.sh delta -1
execp_dwheel_command = /home/sb/.openbox-music/workspace-switch.sh delta 1

execp = new
execp_command = /home/sb/.openbox-music/workspace-switch.sh show 1
execp_interval = 1
execp_has_icon = 0
execp_cache_icon = 1
execp_continuous = 0
execp_markup = 1
execp_tooltip = Workspace
execp_font = sans 9
execp_font_color = #888888 100
execp_padding = 8 4
execp_background_id = 0
execp_centered = 1
execp_lclick_command = /home/sb/.openbox-music/workspace-switch.sh goto 1
execp_uwheel_command = /home/sb/.openbox-music/workspace-switch.sh delta -1
execp_dwheel_command = /home/sb/.openbox-music/workspace-switch.sh delta 1

# Clock
time1_format = %H:%M
time2_format =
time1_font = sans bold 11
time1_timezone =
time2_timezone =
time2_font = sans 7
clock_font_color = #dddddd 100
clock_padding = 8 0
clock_background_id = 0
clock_tooltip = %A %d %B %Y
clock_tooltip_timezone =
clock_lclick_command =
clock_rclick_command =
clock_mclick_command =
clock_uwheel_command =
clock_dwheel_command =

# Battery hidden on a desktop
battery_hide = 101
battery_tooltip = 0

# Tooltip
tooltip_show_timeout = 0.4
tooltip_hide_timeout = 0.1
tooltip_padding = 6 4
tooltip_background_id = 5
tooltip_font_color = #eeeeee 100
tooltip_font = sans 9
