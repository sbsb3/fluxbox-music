<?xml version="1.0" encoding="UTF-8"?>
<!-- ~/.config/openbox-music-kiosk/rc.xml -->
<openbox_config xmlns="http://openbox.org/3.4/rc">

  <!-- New windows open on the RandR primary monitor (DP-4) -->
  <placement>
    <position>center</position>
    <monitor>Primary</monitor>
  </placement>

  <!-- Theme: same as the user's default openbox config (~/.config/openbox/
       rc.xml).  Without a <theme> section Openbox falls back to its
       compiled-in Clearlooks default.  modernflatdark is the installed
       theme the user already chose.  titleLayout NLIMC = icon, label,
       iconify, maximize, close (left to right). -->
  <theme>
    <name>modernflatdark</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <animateIconify>yes</animateIconify>
    <font place="ActiveWindow">
      <name>sans</name>
      <size>8</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>sans</name>
      <size>8</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="MenuHeader">
      <name>sans</name>
      <size>9</size>
      <weight>normal</weight>
      <slant>normal</slant>
    </font>
    <font place="MenuItem">
      <name>sans</name>
      <size>9</size>
      <weight>normal</weight>
      <slant>normal</slant>
    </font>
    <font place="ActiveOnScreenDisplay">
      <name>sans</name>
      <size>9</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="InactiveOnScreenDisplay">
      <name>sans</name>
      <size>9</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
  </theme>

  <!-- Focus follows mouse, raise on click.  Same as Openbox default. -->
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
  </focus>

  <!-- Keyboard is intentionally almost empty: this is a kiosk and Plank
       (running apps show an indicator; clicking the icon raises/cycles
       that app) is the app switcher, so no Alt-Tab. The single binding
       C-A-End exits Openbox, which ends the session (music-kiosk.sh is
       blocked on `wait $obpid`). renoise-kiosk ties session exit to
       Renoise quitting; this multi-app session has no single owning app,
       so an explicit exit binding is required. -->
  <keyboard>
    <keybind key="C-A-End">
      <action name="Exit"/>
    </keybind>
  </keyboard>

  <mouse>
    <dragThreshold>8</dragThreshold>
    <doubleClickTime>500</doubleClickTime>

    <!-- Alt-drag anywhere on the frame: move / resize fallback -->
    <context name="Frame">
      <mousebind button="A-Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="A-Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="A-Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="A-Right" action="Drag">
        <action name="Resize"/>
      </mousebind>
    </context>

    <!-- Titlebar: drag to move, double-click to maximize -->
    <context name="Titlebar">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize"/>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="ShowMenu"><menu>client-menu</menu></action>
      </mousebind>
    </context>

    <!-- Resize edges -->
    <context name="Top">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>top</edge></action>
      </mousebind>
    </context>
    <context name="Left">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>left</edge></action>
      </mousebind>
    </context>
    <context name="Right">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>right</edge></action>
      </mousebind>
    </context>
    <context name="Bottom">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>bottom</edge></action>
      </mousebind>
    </context>

    <!-- Resize corners -->
    <context name="TRCorner BRCorner TLCorner BLCorner">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Resize"/>
      </mousebind>
    </context>

    <!-- Click to focus; Alt-drag as fallback move/resize for any window -->
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="A-Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="A-Right" action="Drag">
        <action name="Resize"/>
      </mousebind>
    </context>

    <!-- Window icon: click for client menu (close, maximize, etc.) -->
    <context name="Icon">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="ShowMenu"><menu>client-menu</menu></action>
      </mousebind>
    </context>

    <!-- Minimize button -->
    <context name="Iconify">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="Iconify"/>
      </mousebind>
    </context>

    <!-- Maximize button: left=toggle, middle=vertical, right=horizontal -->
    <context name="Maximize">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="ToggleMaximize"/>
      </mousebind>
      <mousebind button="Middle" action="Click">
        <action name="ToggleMaximize"><direction>vertical</direction></action>
      </mousebind>
      <mousebind button="Right" action="Click">
        <action name="ToggleMaximize"><direction>horizontal</direction></action>
      </mousebind>
    </context>

    <!-- Close button -->
    <context name="Close">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="Close"/>
      </mousebind>
    </context>

    <!-- Desktop: click to focus/raise, right-click for root menu -->
    <context name="Desktop">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="ShowMenu"><menu>root-menu</menu></action>
      </mousebind>
    </context>
  </mouse>

  <!-- Menu: loads ~/.config/openbox/menu.xml (or /etc/xdg/openbox/menu.xml
       as fallback) so the root-menu works on right-click of the desktop.
       client-menu is built-in and always available. -->
  <menu>
    <file>menu.xml</file>
    <hideDelay>200</hideDelay>
    <middle>no</middle>
    <submenuShowDelay>100</submenuShowDelay>
    <submenuHideDelay>400</submenuHideDelay>
    <showIcons>yes</showIcons>
    <manageDesktops>yes</manageDesktops>
  </menu>

  <applications>
    <!-- Plank: above layer so maximized/fullscreen DAWs cannot bury the
         dock; undecorated; on all desktops. Mirrors the openbox-music
         rc.xml rule (gap #1). Plank windows are type=dock, so the DAW
         fullscreen rules below don't catch the dock. -->
    <application class="Plank">
      <layer>above</layer>
      <decor>no</decor>
      <skip_taskbar>yes</skip_taskbar>
      <skip_pager>yes</skip_pager>
      <desktop>all</desktop>
    </application>

    <!-- Each DAW: fullscreen, undecorated, forced onto DP-4 (primary).
         force="yes" overrides the app's saved geometry, which otherwise
         maps onto the portrait DP-2 and fullscreens clipped there
         (Renoise is the known case; the others get the same treatment
         for a consistent kiosk). No <monitor> index here on purpose:
         per-app <position><monitor> takes a raw 0-based RandR index whose
         numbering vs. DP-4/DP-2/HDMI-0 was never confirmed (see
         renoise-staging rc.xml for the same reasoning); x/y is
         unambiguous instead. The point 3406x882 is the CENTER of DP-4's
         rectangle (DP-4 pos 2446x342, size 1920x1080 -> center
         2446+960, 342+540), strictly inside DP-4 and clear of all
         monitor boundaries, so Openbox finds DP-4 from the point alone.
         (Was 0x0 when DP-4 sat at 0x0 in the 2-monitor kiosk layout; the
         3-monitor XFCE-exact layout moved DP-4 to 2446x342, so 0x0 now
         lands in HDMI-0's rect and had to move with it.)

         WM_CLASS class fields: Renoise and sunvox are confirmed live
         (sunvox is lowercase). Bitwig's comes from its .desktop
         StartupWMClass=com.bitwig.BitwigStudio. Max 9 is a Wine app; its
         .desktop StartupWMClass=max.exe; Wine typically sets WM_CLASS
         to the .exe name, so class="max.exe" is the best guess; if a
         launched Max window does not go fullscreen, run
           xprop WM_CLASS | grep -i max
         on it and correct the class below. -->
    <application class="Renoise" type="normal">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <position force="yes">
        <x>3406</x>
        <y>882</y>
      </position>
    </application>
    <application class="com.bitwig.BitwigStudio" type="normal">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <position force="yes">
        <x>3406</x>
        <y>882</y>
      </position>
    </application>
    <!-- SunVox: windowed (its own settings disable fullscreen), placed on
         DP-4 top-left.  Do NOT set <fullscreen>yes</fullscreen> here:
         Openbox applies <fullscreen> before <position>, so a forced
         fullscreen snaps to whichever monitor has focus at launch time
         (a secondary: HDMI-0 / DP-2) and the later <position> rule cannot
         move it back: the window keeps the wrong monitor's rect.
         <position><x><y> sets the window's TOP-LEFT corner, not its
         center, so 3406x882 (DP-4 center) pushed the window past the
         bottom-right edge.  2456x352 = DP-4 origin (2446x342) + 10px
         margin.  decor=yes so the user can move/resize the windowed app. -->
    <application class="sunvox" type="normal">
      <decor>yes</decor>
      <position force="yes">
        <x>2456</x>
        <y>352</y>
      </position>
    </application>
    <application class="max.exe" type="normal">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <position force="yes">
        <x>3406</x>
        <y>882</y>
      </position>
    </application>

    <!-- Plugin editors and dialogs: floating, decorated, draggable.
         <layer>above</layer> is required for these to be visible over a
         fullscreen DAW on DP-4: fullscreen Normal-layer windows stack above
         other Normal-layer windows in Openbox, so without this a zenity
         logout dialog (or any plugin alert / file picker) maps behind the
         DAW and is invisible: the user sees nothing and keeps clicking
         the launcher, piling up hidden dialogs. `above` lifts them over
         fullscreen Normal windows (same reason Plank/tint2 are `above`). -->
    <application name="*" type="dialog">
      <decor>yes</decor>
      <fullscreen>no</fullscreen>
      <layer>above</layer>
    </application>
    <application name="*" type="utility">
      <decor>yes</decor>
      <fullscreen>no</fullscreen>
      <layer>above</layer>
    </application>
  </applications>

</openbox_config>
