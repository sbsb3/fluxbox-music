<?xml version="1.0" encoding="UTF-8"?>
<!-- ~/.config/openbox-music-kiosk/rc.xml -->
<openbox_config xmlns="http://openbox.org/3.4/rc">

  <!-- New windows open on the RandR primary monitor (DP-4) -->
  <placement>
    <position>center</position>
    <monitor>Primary</monitor>
  </placement>

  <!-- Theme: same as the user's default openbox config (~/.config/openbox/
       rc.xml).  Without a <theme> section Openbox falls back to its
       compiled-in Clearlooks default.  modernflatdark is the installed
       theme the user already chose.  titleLayout NLIMC = icon, label,
       iconify, maximize, close (left to right). -->
  <theme>
    <name>modernflatdark</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <animateIconify>yes</animateIconify>
    <font place="ActiveWindow">
      <name>sans</name>
      <size>8</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>sans</name>
      <size>8</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="MenuHeader">
      <name>sans</name>
      <size>9</size>
      <weight>normal</weight>
      <slant>normal</slant>
    </font>
    <font place="MenuItem">
      <name>sans</name>
      <size>9</size>
      <weight>normal</weight>
      <slant>normal</slant>
    </font>
    <font place="ActiveOnScreenDisplay">
      <name>sans</name>
      <size>9</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="InactiveOnScreenDisplay">
      <name>sans</name>
      <size>9</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
  </theme>

  <!-- Focus follows mouse, raise on click.  Same as Openbox default. -->
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
  </focus>

  <!-- Keyboard: Alt-Tab delegates to the skippy-xd-based switcher
       (same as the default openbox config), C-A-End exits Openbox
       which ends the session (music-kiosk.sh is blocked on wait $obpid). -->
  <keyboard>
    <keybind key="A-Tab">
      <action name="Execute"><command>/home/sb/scripts/alttab.sh next</command></action>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="Execute"><command>/home/sb/scripts/alttab.sh prev</command></action>
    </keybind>
    <keybind key="C-A-End">
      <action name="Exit"/>
    </keybind>
    <keybind key="W-r">
      <action name="Execute"><command>rofi -show run</command></action>
    </keybind>
    <keybind key="W-t">
      <action name="Execute"><command>/home/sb/.local/bin/clock-pop</command></action>
    </keybind>
  </keyboard>

  <mouse>
    <dragThreshold>8</dragThreshold>
    <doubleClickTime>500</doubleClickTime>

    <!-- Alt-drag anywhere on the frame: move / resize fallback -->
    <context name="Frame">
      <mousebind button="A-Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="A-Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="A-Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="A-Right" action="Drag">
        <action name="Resize"/>
      </mousebind>
    </context>

    <!-- Titlebar: drag to move, double-click to maximize -->
    <context name="Titlebar">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize"/>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="ShowMenu"><menu>client-menu</menu></action>
      </mousebind>
    </context>

    <!-- Resize edges -->
    <context name="Top">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>top</edge></action>
      </mousebind>
    </context>
    <context name="Left">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>left</edge></action>
      </mousebind>
    </context>
    <context name="Right">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>right</edge></action>
      </mousebind>
    </context>
    <context name="Bottom">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>bottom</edge></action>
      </mousebind>
    </context>

    <!-- Resize corners -->
    <context name="TRCorner BRCorner TLCorner BLCorner">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Resize"/>
      </mousebind>
    </context>

    <!-- Click to focus; Alt-drag as fallback move/resize for any window -->
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="A-Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="A-Right" action="Drag">
        <action name="Resize"/>
      </mousebind>
    </context>

    <!-- Window icon: click for client menu (close, maximize, etc.) -->
    <context name="Icon">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="ShowMenu"><menu>client-menu</menu></action>
      </mousebind>
    </context>

    <!-- Minimize button -->
    <context name="Iconify">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="Iconify"/>
      </mousebind>
    </context>

    <!-- Maximize button: left=toggle, middle=vertical, right=horizontal -->
    <context name="Maximize">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="ToggleMaximize"/>
      </mousebind>
      <mousebind button="Middle" action="Click">
        <action name="ToggleMaximize"><direction>vertical</direction></action>
      </mousebind>
      <mousebind button="Right" action="Click">
        <action name="ToggleMaximize"><direction>horizontal</direction></action>
      </mousebind>
    </context>

    <!-- Close button -->
    <context name="Close">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="Close"/>
      </mousebind>
    </context>

    <!-- Desktop: click to focus/raise only. No right-click menu: this is
         a kiosk, the root-menu / client-list menus are not useful and
         would just confuse the user. -->
    <context name="Desktop">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
    </context>
  </mouse>

  <applications>
    <!-- Plank: above layer so maximized/fullscreen DAWs cannot bury the
         dock; undecorated; on all desktops. Mirrors the openbox-music
         rc.xml rule (gap #1). Plank windows are type=dock, so the DAW
         fullscreen rules below don't catch the dock. -->
    <application class="Plank">
      <layer>above</layer>
      <decor>no</decor>
      <skip_taskbar>yes</skip_taskbar>
      <skip_pager>yes</skip_pager>
      <desktop>all</desktop>
    </application>

    <!-- Each DAW: maximized (NOT fullscreen), undecorated, forced onto
         DP-4 (primary).  <fullscreen>yes</fullscreen> was the original
         approach but it raises the window above EVERYTHING in Openbox,
         including Plank's `above` layer, so Plank could not reveal on
         mouse-hover while a fullscreen DAW had focus.  <maximized> fills
         the monitor the same way but keeps the window in the Normal
         layer, so Plank (above) can reveal over it.  This matches the
         openbox-music session, where Renoise has no fullscreen rule at
         all and Plank hide-mode works correctly.

         force="yes" overrides the app's saved geometry, which otherwise
         maps onto the portrait DP-2 (Renoise is the known case).  The
         point 3406x882 is the CENTER of DP-4's rectangle (DP-4 pos
         2446x342, size 1920x1080 -> center 2446+960, 342+540), strictly
         inside DP-4, so Openbox finds DP-4 from the point alone and
         maximizes on that monitor.

         WM_CLASS class fields: Renoise and sunvox are confirmed live
         (sunvox is lowercase). Bitwig's comes from its .desktop
         StartupWMClass=com.bitwig.BitwigStudio. Max 9 is a Wine app; its
         .desktop StartupWMClass=max.exe; Wine typically sets WM_CLASS
         to the .exe name, so class="max.exe" is the best guess. -->
    <application class="Renoise" type="normal">
      <decor>no</decor>
      <maximized>yes</maximized>
      <position force="yes">
        <x>3406</x>
        <y>882</y>
      </position>
    </application>
    <application class="com.bitwig.BitwigStudio" type="normal">
      <decor>no</decor>
      <maximized>yes</maximized>
      <position force="yes">
        <x>3406</x>
        <y>882</y>
      </position>
    </application>
    <!-- SunVox: windowed (its own settings disable fullscreen), placed on
         DP-4 top-left.  Do NOT set <fullscreen>yes</fullscreen> here:
         Openbox applies <fullscreen> before <position>, so a forced
         fullscreen snaps to whichever monitor has focus at launch time
         (a secondary: HDMI-0 / DP-2) and the later <position> rule cannot
         move it back: the window keeps the wrong monitor's rect.
         <position><x><y> sets the window's TOP-LEFT corner, not its
         center, so 3406x882 (DP-4 center) pushed the window past the
         bottom-right edge.  2456x352 = DP-4 origin (2446x342) + 10px
         margin.  decor=yes so the user can move/resize the windowed app.

         SunVox's SunDog engine writes an off-screen "user specified
         location" into WM_NORMAL_HINTS at startup and XMoveWindow's
         itself there shortly after mapping, which beats this
         <position force="yes"> rule (force only applies once, on
         initial placement).  sunvox-fix.py re-positions the window
         for the first few seconds after launch — leave this rule in
         place so the first paint and the watcher's first read both
         land on DP-4. -->
    <application class="sunvox" type="normal">
      <decor>yes</decor>
      <position force="yes">
        <x>2456</x>
        <y>352</y>
      </position>
    </application>
    <application class="max.exe" type="normal">
      <decor>yes</decor>
    </application>

    <!-- Plugin editors and dialogs: floating, decorated, draggable.
         <layer>above</layer> keeps these visible over a maximized DAW on
         DP-4: maximized Normal-layer windows stack above other Normal-
         layer windows in Openbox, so without this a zenity logout dialog
         (or any plugin alert / file picker) could map behind the DAW.
         `above` lifts them over maximized Normal windows (same reason
         Plank is `above`). -->
    <application name="*" type="dialog">
      <decor>yes</decor>
      <fullscreen>no</fullscreen>
      <layer>above</layer>
    </application>
    <application name="*" type="utility">
      <decor>yes</decor>
      <fullscreen>no</fullscreen>
      <layer>above</layer>
    </application>
  </applications>

</openbox_config>
