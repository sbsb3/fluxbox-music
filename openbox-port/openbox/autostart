#!/bin/sh
#
# Openbox's own per-user autostart hook: /usr/lib/openbox/openbox-autostart
# sources this unconditionally after Openbox is already running, regardless
# of which xsessions .desktop entry launched it ("Openbox" or "Openbox
# Music") -- see PORT-NOTES.md. This exists because the greeter remembers
# the last-picked session and does not switch to "Openbox Music" on its
# own, so relying on that entry alone left every plain "Openbox" login
# missing HDMI/DPI/Plank/picom/tint2. Putting the setup here instead makes
# it unconditional: any Openbox login gets the full music-session setup.
#
# IMPORTANT: unlike ~/.openbox-music/startup, this file must NOT launch
# Openbox itself (it's already running) and must NOT block with `wait` --
# openbox-autostart runs this synchronously and then moves on to XDG
# autostart (gajim, arch-update-tray, etc.), so everything long-running
# here backgrounds itself and returns.

obdir="${HOME}/.openbox-music"

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Openbox}"
export GDK_BACKEND=x11
export QT_QPA_PLATFORM=xcb
# Without this, Qt apps (CopyQ, QOwnNotes, ...) have no platform theme
# plugin at all in this session -- ~/.config/environment.d/gtk-theme.conf
# sets this too, but that's a systemd --user env generator and never
# reaches processes openbox-autostart itself spawns. gtk3 makes Qt pull
# its palette from the GTK_THEME/settings.ini above instead of Qt's
# built-in light default.
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-gtk3}"
export GTK_THEME="${GTK_THEME:-Adwaita-dark}"
export GTK_ICON_THEME_NAME="${GTK_ICON_THEME_NAME:-Adwaita-Red}"
export XCURSOR_THEME="${XCURSOR_THEME:-Adwaita}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
export GDK_SCALE=1
export QT_AUTO_SCREEN_SCALE_FACTOR=0
export JACK_NO_START_SERVER=1

export VST3_PATH="${HOME}/.vst3:${HOME}/vst3:/usr/lib/vst3${VST3_PATH:+:$VST3_PATH}"
export VST_PATH="${HOME}/.vst:/usr/lib/vst${VST_PATH:+:$VST_PATH}"
export CLAP_PATH="${HOME}/.clap:/usr/lib/clap${CLAP_PATH:+:$CLAP_PATH}"
export LV2_PATH="${HOME}/.lv2:/usr/lib/lv2${LV2_PATH:+:$LV2_PATH}"

have() { command -v "$1" >/dev/null 2>&1; }

# Restore the saved 3-monitor layout before anything paints the desktop.
if have autorandr; then
    autorandr --change --default default >/dev/null 2>&1 || autorandr default >/dev/null 2>&1 || true
fi

if have xset; then
    xset -b 2>/dev/null
    xset s off 2>/dev/null
    xset -dpms 2>/dev/null
    xset s noblank 2>/dev/null
fi

# Xft.dpi lives here -- without it X computes DPI from the L-shaped virtual
# screen's physical size and everything (Renoise text included) renders at
# the wrong scale.
if [ -f "${HOME}/.Xresources" ]; then
    xrdb -merge "${HOME}/.Xresources" 2>/dev/null
fi
if [ -f "${obdir}/Xresources" ]; then
    xrdb -merge "${obdir}/Xresources" 2>/dev/null
fi
if [ -f "${HOME}/.Xmodmap" ]; then
    xmodmap "${HOME}/.Xmodmap" 2>/dev/null
fi

if have xsetroot; then
    xsetroot -solid "#0b0b0d" 2>/dev/null
    xsetroot -cursor_name left_ptr 2>/dev/null
fi

set_wallpaper() {
    if have feh && [ -f "${HOME}/.fluxbox/backgrounds/music-dark.png" ]; then
        feh --no-fehbg --bg-fill "${HOME}/.fluxbox/backgrounds/music-dark.png"
    elif have feh; then
        feh --no-fehbg --bg-fill --solid-bg "#0b0b0d" /usr/share/pixmaps/openbox.png 2>/dev/null || true
    fi
}

place_tint2() {
    have xdotool || return 0
    have xrandr || return 0
    i=0
    while [ "$i" -lt 15 ]; do
        wid=$(xdotool search --class Tint2 2>/dev/null | head -n 1) || wid=
        if [ -n "$wid" ]; then
            geom=$(xrandr --query | awk '/ primary / {
                for (i = 1; i <= NF; i++)
                    if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) print $i
            }')
            [ -n "$geom" ] || return 0
            w=${geom%%x*}
            rest=${geom#*x}
            h=${rest%%+*}
            rest=${rest#*+}
            x=${rest%%+*}
            y=${rest#*+}
            ph=$(xdotool getwindowgeometry "$wid" 2>/dev/null | awk '/Geometry:/{split($2,a,"x"); print a[2]}')
            ph=${ph:-56}
            py=$y
            xdotool windowmove "$wid" "$x" "$py" 2>/dev/null || true
            xdotool windowsize "$wid" "$w" "$ph" 2>/dev/null || true
            return 0
        fi
        i=$((i + 1))
        sleep 0.2
    done
}

wait_heads() {
    have xrandr || return 0
    last=
    i=0
    while [ "$i" -lt 25 ]; do
        n=$(xrandr --listactivemonitors 2>/dev/null | awk 'NR==1 { print $2 }')
        n=${n:-0}
        if [ -n "$last" ] && [ "$n" = "$last" ] && [ "$n" -ge 1 ] && [ "$i" -ge 3 ]; then
            return 0
        fi
        last=$n
        i=$((i + 1))
        sleep 0.2
    done
}

set_wallpaper

if have xfsettingsd; then
    xfsettingsd --disable-wm-check --replace &
fi

if have picom; then
    picom --config "${HOME}/.config/picom/fluxbox-music.conf" --daemon
fi

wait_heads
if [ -x "${obdir}/apply-workspaces.sh" ]; then
    "${obdir}/apply-workspaces.sh" || true
fi
if python3 -c "import Xlib" >/dev/null 2>&1 && [ -x "${obdir}/desktop-heads.py" ]; then
    "${obdir}/desktop-heads.py" --once || true
fi
if have pcmanfm; then
    pcmanfm --desktop --profile fluxbox-music &
fi
if python3 -c "import Xlib" >/dev/null 2>&1 && [ -x "${obdir}/desktop-heads.py" ]; then
    (
        while :; do
            "${obdir}/desktop-heads.py" >>/tmp/desktop-heads-openbox.log 2>&1
            echo "desktop-heads: exited ($?), restarting" >>/tmp/desktop-heads-openbox.log
            sleep 2
        done
    ) &
fi
if python3 -c "import Xlib" >/dev/null 2>&1 && [ -x "${obdir}/audacious-stack.py" ]; then
    "${obdir}/audacious-stack.py" &
fi
if python3 -c "import Xlib" >/dev/null 2>&1 && [ -x "${obdir}/window-icons.py" ]; then
    "${obdir}/window-icons.py" &
fi

if have tint2; then
    tint_rc="${HOME}/.config/tint2/openbox-music-active.tint2rc"
    if [ ! -e "$tint_rc" ]; then
        tint_rc="${HOME}/.config/tint2/openbox-music.tint2rc"
    fi
    tint2 -c "$tint_rc" &
    place_tint2 &
    # tint2 has a real, reproducible crash (SIGSEGV, systray-related --
    # coredumps show the same instruction offset both times it happened)
    # and nothing here relaunches it. Left alone it stays dead until
    # task-menu.py's unrelated SIGUSR1 self-heal happens to notice and kick
    # it, which is not what that self-heal is for and can take a while.
    # Poll rather than watch a pid directly so panel-size.sh's own
    # deliberate kill+relaunch (toggling normal/compact) is never mistaken
    # for a crash -- confirm tint2 has been gone for a full second, past
    # that script's own ~0.35s gap, before treating it as one.
    if [ -x "${obdir}/panel-size.sh" ]; then
        (
            while :; do
                while pgrep -x tint2 >/dev/null 2>&1; do
                    sleep 1
                done
                sleep 1
                pgrep -x tint2 >/dev/null 2>&1 && continue
                echo "tint2: not running, restarting via panel-size.sh" >>/tmp/tint2-openbox.log
                cur=$("${obdir}/panel-size.sh" show 2>/dev/null) || cur=normal
                "${obdir}/panel-size.sh" "$cur" >>/tmp/tint2-openbox.log 2>&1
            done
        ) &
    fi
fi
if python3 -c "import Xlib, gi" >/dev/null 2>&1 && [ -x "${obdir}/task-menu.py" ]; then
    "${obdir}/task-menu.py" &
fi
if python3 -c "import Xlib" >/dev/null 2>&1 && [ -x "${obdir}/taskbar-sync.py" ]; then
    "${obdir}/taskbar-sync.py" &
fi

if have plank; then
    plank -n music &
fi

if python3 -c "import Xlib" >/dev/null 2>&1 && [ -x "${obdir}/fullscreen-panel.py" ]; then
    # Diagnosing an intermittent panel flicker (hide/restore vs. task-menu.py's
    # SIGUSR1 self-heal vs. an actual tint2/openbox crash) is guesswork without
    # a trail -- keep a small rotating log of this script's own hide/restore
    # decisions so the next flicker has one.
    FULLSCREEN_PANEL_LOG="/tmp/fullscreen-panel-openbox.log" "${obdir}/fullscreen-panel.py" &
fi

if have dunst; then
    if have systemctl; then
        systemctl --user mask xfce4-notifyd.service >/dev/null 2>&1 || true
        systemctl --user stop xfce4-notifyd.service >/dev/null 2>&1 || true
    fi
    dunst -config "${HOME}/.config/dunst/fluxbox-music.conf" &
fi

start_tray_applets() {
    if have pasystray; then
        pasystray &
    fi
    if have nm-applet; then
        nm-applet &
    fi
}
(sleep 0.6; start_tray_applets) &
(sleep 0.8; set_wallpaper) &
