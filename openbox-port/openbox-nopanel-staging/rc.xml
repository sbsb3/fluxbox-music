<?xml version="1.0" encoding="UTF-8"?>
<!-- ~/.config/openbox-nopanel/rc.xml
     Openbox No Panel: music-production Openbox session that runs the
     openbox-music-session keybindings (W-1/2 workspace switch,
     W-Space root-menu, W-F4 close, W-F10 maximize, ...) and the
     restored Openbox root-menu / workspace-menu, but with NO tint2
     panel and NO Plank dock.  Same per-app rules as Music Kiosk
     (Renoise/Bitwig maximize on DP-4, SunVox on DP-4 top-left,
     dialogs/utility windows in the `above` layer).

     The autostart guard OPENBOX_NOPANEL_SESSION=1 in
     ~/.config/openbox/autostart keeps that hook from relaunching
     tint2/plank/pcmanfm here.  It stands down silently.

     Super (Mod4/"W") is the session modifier so Ctrl/Alt stay available
     to the DAWs.  Function-key workspace binds from stock defaults are
     omitted on purpose (Renoise, Bitwig, SunVox, and Max all use
     F-keys). -->
<openbox_config xmlns="http://openbox.org/3.4/rc"
		xmlns:xi="http://www.w3.org/2001/XInclude">

<resistance>
  <strength>8</strength>
  <screen_edge_strength>8</screen_edge_strength>
</resistance>

<focus>
  <focusNew>yes</focusNew>
  <followMouse>no</followMouse>
  <focusLast>yes</focusLast>
  <underMouse>no</underMouse>
  <raiseOnFocus>no</raiseOnFocus>
</focus>

<placement>
  <!-- Smart placement (top-left start) is the closest Openbox match
       to Fluxbox's RowSmartPlacement.  New windows open on the RandR
       primary monitor (DP-4). -->
  <policy>Smart</policy>
  <center>no</center>
  <monitor>Primary</monitor>
  <primaryMonitor>1</primaryMonitor>
</placement>

<theme>
  <!-- Same theme as the existing openbox-music session.
       modernflatdark does not declare a font.size in themerc, so
       without explicit <font> blocks here Openbox falls back to its
       compiled-in ~8px defaults.  Menu text is tiny.  Size 12 for
       items, 13 for the menu header; same family/weight as the
       window labels so it doesn't look out of place in the active
       window's title bar. -->
  <name>modernflatdark</name>
  <titleLayout>NLIMC</titleLayout>
  <keepBorder>yes</keepBorder>
  <animateIconify>yes</animateIconify>
  <font place="ActiveWindow">
    <name>sans</name>
    <size>8</size>
    <weight>bold</weight>
    <slant>normal</slant>
  </font>
  <font place="InactiveWindow">
    <name>sans</name>
    <size>8</size>
    <weight>bold</weight>
    <slant>normal</slant>
  </font>
  <font place="MenuHeader">
    <name>sans</name>
    <size>13</size>
    <weight>bold</weight>
    <slant>normal</slant>
  </font>
  <font place="MenuItem">
    <name>sans</name>
    <size>12</size>
    <weight>normal</weight>
    <slant>normal</slant>
  </font>
  <font place="ActiveOnScreenDisplay">
    <name>sans</name>
    <size>12</size>
    <weight>bold</weight>
    <slant>normal</slant>
  </font>
  <font place="InactiveOnScreenDisplay">
    <name>sans</name>
    <size>12</size>
    <weight>bold</weight>
    <slant>normal</slant>
  </font>
</theme>

<desktops>
  <!-- Two desktops, same names as the openbox-music session: Internet
       and Audio.  Kiosk users don't need more, and it keeps the
       workspace-menu (root-menu -> Workspaces) small. -->
  <number>2</number>
  <firstdesk>1</firstdesk>
  <names>
    <name>Internet</name>
    <name>Audio</name>
  </names>
  <popupTime>875</popupTime>
</desktops>

<resize>
  <drawContents>no</drawContents>
  <popupShow>Nonpixel</popupShow>
  <popupPosition>Center</popupPosition>
</resize>

<margins>
  <top>0</top>
  <bottom>0</bottom>
  <left>0</left>
  <right>0</right>
</margins>

<dock>
  <!-- Unused: tint2/Plank are ordinary top-level dock windows, not a
       Fluxbox-slit-style Openbox dock app.  Left at stock defaults. -->
  <position>TopLeft</position>
  <floatingX>0</floatingX>
  <floatingY>0</floatingY>
  <noStrut>no</noStrut>
  <stacking>Above</stacking>
  <direction>Vertical</direction>
  <autoHide>no</autoHide>
  <hideDelay>300</hideDelay>
  <showDelay>300</showDelay>
  <moveButton>Middle</moveButton>
</dock>

<keyboard>
  <chainQuitKey>C-g</chainQuitKey>

  <!-- Workspaces (Internet, Audio) -->
  <keybind key="W-1"><action name="GoToDesktop"><to>1</to></action></keybind>
  <keybind key="W-2"><action name="GoToDesktop"><to>2</to></action></keybind>
  <keybind key="W-S-1"><action name="SendToDesktop"><to>1</to></action></keybind>
  <keybind key="W-S-2"><action name="SendToDesktop"><to>2</to></action></keybind>
  <keybind key="W-Tab"><action name="GoToDesktop"><to>next</to><wrap>yes</wrap></action></keybind>
  <keybind key="W-S-Tab"><action name="GoToDesktop"><to>previous</to><wrap>yes</wrap></action></keybind>
  <keybind key="C-A-Left"><action name="GoToDesktop"><to>previous</to><wrap>yes</wrap></action></keybind>
  <keybind key="C-A-Right"><action name="GoToDesktop"><to>next</to><wrap>yes</wrap></action></keybind>
  <keybind key="W-Left"><action name="SendToDesktop"><to>previous</to><wrap>yes</wrap></action></keybind>
  <keybind key="W-Right"><action name="SendToDesktop"><to>next</to><wrap>yes</wrap></action></keybind>

  <!-- Window cycling: Alt-Tab delegates to the skippy-xd-based switcher. -->
  <keybind key="A-Tab">
    <action name="Execute"><command>/home/sb/scripts/alttab.sh next</command></action>
  </keybind>
  <keybind key="A-S-Tab">
    <action name="Execute"><command>/home/sb/scripts/alttab.sh prev</command></action>
  </keybind>

  <!-- Session launchers (Super + key) -->
  <keybind key="W-Return"><action name="Execute"><command>wezterm</command></action></keybind>
  <keybind key="W-space"><action name="ShowMenu"><menu>root-menu</menu></action></keybind>
  <keybind key="W-r"><action name="Execute"><command>rofi -show run</command></action></keybind>
  <keybind key="W-e"><action name="Execute"><command>pcmanfm --profile fluxbox-music</command></action></keybind>
  <keybind key="W-s"><action name="Execute"><command>sunvox</command></action></keybind>
  <keybind key="A-W-r"><action name="Execute"><command>renoise</command></action></keybind>
  <keybind key="W-b"><action name="Execute"><command>bitwig-studio</command></action></keybind>
  <keybind key="W-c"><action name="Execute"><command>gsimplecal</command></action></keybind>
  <keybind key="W-g"><action name="Execute"><command>qpwgraph</command></action></keybind>
  <keybind key="W-Shift-v"><action name="Execute"><command>pavucontrol</command></action></keybind>
  <keybind key="W-h"><action name="Execute"><command>hydrogen</command></action></keybind>
  <keybind key="W-m"><action name="Execute"><command>/home/sb/bin/max9.sh</command></action></keybind>
  <keybind key="W-p"><action name="Execute"><command>plugdata</command></action></keybind>
  <keybind key="W-z"><action name="Execute"><command>zynaddsubfx -I jack -O jack</command></action></keybind>
  <keybind key="W-w"><action name="Execute"><command>pcmanfm --profile fluxbox-music /home/sb/Music</command></action></keybind>
  <keybind key="W-F4"><action name="Close"/></keybind>
  <keybind key="W-F9"><action name="Iconify"/></keybind>
  <keybind key="W-F10"><action name="ToggleMaximize"/></keybind>
  <keybind key="W-F11"><action name="ToggleFullscreen"/></keybind>

  <!-- Window ops that do not eat DAW F-keys -->
  <keybind key="A-F2"><action name="Execute"><command>rofi -show run</command></action></keybind>
  <keybind key="A-F4"><action name="Close"/></keybind>
  <keybind key="A-F9"><action name="Iconify"/></keybind>
  <keybind key="A-F10"><action name="ToggleMaximize"/></keybind>
  <keybind key="A-F11"><action name="ToggleFullscreen"/></keybind>
  <keybind key="A-space"><action name="ShowMenu"><menu>client-menu</menu></action></keybind>
  <keybind key="W-S-Escape"><action name="Kill"/></keybind>

  <!-- Audacious volume via audtool (XFCE parity). -->
  <keybind key="XF86AudioRaiseVolume"><action name="Execute"><command>/home/sb/.local/bin/audacious-vol +</command></action></keybind>
  <keybind key="XF86AudioLowerVolume"><action name="Execute"><command>/home/sb/.local/bin/audacious-vol -</command></action></keybind>
  <keybind key="XF86AudioMute"><action name="Execute"><command>/home/sb/.local/bin/audacious-vol mute</command></action></keybind>

  <keybind key="Print"><action name="Execute"><command>scrot "/home/sb/Pictures/%Y-%m-%d-%H%M%S.png"</command></action></keybind>
  <keybind key="W-Print"><action name="Execute"><command>scrot -s "/home/sb/Pictures/%Y-%m-%d-%H%M%S.png"</command></action></keybind>

  <!-- Reload only.  C-A-Delete used to Exit Openbox from anywhere
       (no prompt).  Disabled on user request; too easy to hit while
       reaching for other shortcuts in Renoise/Bitwig.  Leave Openbox
       via the root-menu -> Session -> Leave Openbox No Panel item,
       or kill the openbox process from outside the session. -->
  <keybind key="W-S-r"><action name="Execute"><command>openbox --reconfigure</command></action></keybind>

  <!-- Music-kiosk specific: clock-pop (W-t).  There's no panel in this
       session but a clock window is still useful.  Same binding as the
       music-kiosk rc.xml. -->
  <keybind key="W-t"><action name="Execute"><command>/home/sb/.local/bin/clock-pop</command></action></keybind>
  <keybind key="W-Shift-c"><action name="Execute"><command>gsimplecal</command></action></keybind>
</keyboard>

<mouse>
  <dragThreshold>1</dragThreshold>
  <doubleClickTime>250</doubleClickTime>
  <screenEdgeWarpTime>400</screenEdgeWarpTime>
  <screenEdgeWarpMouse>false</screenEdgeWarpMouse>

  <!-- Restored Openbox context menu: right-click on the desktop opens
       the root-menu (DAWs, plugin hosts, files, terminal, ...),
       middle-click opens the workspace-menu.  This is the Openbox
       music-session behavior (the Fluxbox desktop right-click is the
       one that opened a separate root-menu).  It is what makes this
       kiosk "the Openbox kiosk with the Openbox context menu"
       instead of the bare-bones music-kiosk one. -->
  <context name="Desktop">
    <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></action></mousebind>
    <mousebind button="Middle" action="Press"><action name="ShowMenu"><menu>workspace-menu</menu></action></mousebind>
  </context>

  <!-- Titlebar-less DAWs (Renoise, Bitwig, Max): Super+right-click is Send To. -->
  <context name="Frame">
    <mousebind button="A-Left" action="Press"><action name="Raise"/><action name="Focus"/></mousebind>
    <mousebind button="A-Left" action="Drag"><action name="Move"/></mousebind>
    <mousebind button="A-Right" action="Press"><action name="Raise"/><action name="Focus"/></mousebind>
    <mousebind button="A-Right" action="Drag"><action name="Resize"/></mousebind>
    <mousebind button="A-Middle" action="Press"><action name="Lower"/><action name="FocusToBottom"/><action name="Unfocus"/></mousebind>
    <mousebind button="W-Right" action="Press"><action name="Focus"/><action name="Raise"/><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
  </context>

  <context name="Titlebar">
    <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize"/></mousebind>
    <mousebind button="Left" action="Drag"><action name="Move"/></mousebind>
    <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/><action name="Unshade"/></mousebind>
    <mousebind button="Middle" action="Press"><action name="Lower"/><action name="FocusToBottom"/><action name="Unfocus"/></mousebind>
    <mousebind button="Right" action="Press"><action name="Focus"/><action name="Raise"/><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
  </context>

  <context name="Top Left Right Bottom TLCorner TRCorner">
    <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/><action name="Unshade"/></mousebind>
    <mousebind button="Left" action="Drag"><action name="Move"/></mousebind>
    <mousebind button="Right" action="Press"><action name="Focus"/><action name="Raise"/><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
  </context>

  <context name="BLCorner">
    <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
    <mousebind button="Left" action="Drag"><action name="Resize"><edge>bottomleft</edge></action></mousebind>
    <mousebind button="Right" action="Press"><action name="Focus"/><action name="Raise"/><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
  </context>
  <context name="BRCorner">
    <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
    <mousebind button="Left" action="Drag"><action name="Resize"><edge>bottomright</edge></action></mousebind>
    <mousebind button="Right" action="Press"><action name="Focus"/><action name="Raise"/><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
  </context>

  <context name="Client">
    <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
    <mousebind button="Middle" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
    <mousebind button="Right" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
  </context>

  <context name="Icon">
    <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/><action name="Unshade"/><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
    <mousebind button="Right" action="Press"><action name="Focus"/><action name="Raise"/><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
  </context>

  <context name="AllDesktops">
    <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/><action name="Unshade"/></mousebind>
    <mousebind button="Left" action="Click"><action name="ToggleOmnipresent"/></mousebind>
  </context>

  <context name="Iconify">
    <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
    <mousebind button="Left" action="Click"><action name="Iconify"/></mousebind>
  </context>

  <context name="Maximize">
    <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/><action name="Unshade"/></mousebind>
    <mousebind button="Left" action="Click"><action name="ToggleMaximize"/></mousebind>
  </context>

  <context name="Close">
    <mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/><action name="Unshade"/></mousebind>
    <mousebind button="Left" action="Click"><action name="Close"/></mousebind>
  </context>

  <context name="Root">
    <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></action></mousebind>
    <mousebind button="Middle" action="Press"><action name="ShowMenu"><menu>workspace-menu</menu></action></mousebind>
  </context>

  <context name="MoveResize">
    <mousebind button="Up" action="Click"><action name="GoToDesktop"><to>previous</to><wrap>yes</wrap></action></mousebind>
    <mousebind button="Down" action="Click"><action name="GoToDesktop"><to>next</to><wrap>yes</wrap></action></mousebind>
  </context>
</mouse>

<menu>
  <!-- Restored Openbox root-menu (DAWs, plugin hosts, files,
       terminal, session).  Identical to the openbox-music
       session's menu.xml so W-space and right-click-on-desktop
       give the user the same menu they're used to in that
       session. -->
  <file>menu.xml</file>
  <hideDelay>200</hideDelay>
  <middle>no</middle>
  <submenuShowDelay>150</submenuShowDelay>
  <submenuHideDelay>400</submenuHideDelay>
  <showIcons>yes</showIcons>
  <manageDesktops>yes</manageDesktops>
</menu>

<applications>
  <!-- Plank is NOT started in this session, but a stale
       plank -n music / default dock1 from a prior Fluxbox or
       openbox-music session could survive into here.  Setting
       its layer/decor is harmless if it never appears. -->
  <application class="Plank">
    <layer>above</layer>
    <decor>no</decor>
    <skip_taskbar>yes</skip_taskbar>
    <skip_pager>yes</skip_pager>
    <desktop>all</desktop>
  </application>

  <!-- pcmanfm (the Fluxbox/openbox-music DESKTOP window) is suppressed
       in this session's startup, but a stale instance from a prior
       session could still draw icons over the wallpapers.
       type="desktop" matches by EWMH window type, so it does not
       affect pcmanfm file-browser windows. -->
  <application class="Pcmanfm" type="desktop">
    <decor>no</decor>
    <skip_taskbar>yes</skip_taskbar>
    <skip_pager>yes</skip_pager>
    <desktop>all</desktop>
  </application>

  <!-- Winamp-skin Audacious: three separate windows, no chrome.
       Positions are restored by audacious-stack.py (transients
       otherwise land on top of the player after a restart). -->
  <application class="Audacious" role="mainwindow">
    <decor>no</decor>
    <layer>above</layer>
    <desktop>2</desktop>
  </application>
  <application class="Audacious" role="equalizer">
    <decor>no</decor>
    <layer>above</layer>
    <desktop>2</desktop>
  </application>
  <application class="Audacious" role="playlist">
    <decor>no</decor>
    <layer>above</layer>
    <desktop>2</desktop>
  </application>

  <!-- Each DAW: maximized (NOT fullscreen), undecorated, forced onto
       DP-4 (primary).  <fullscreen>yes</fullscreen> was the original
       approach but it raises the window above EVERYTHING in Openbox,
       so tooltips and dialogs stack under it.  <maximized> fills the
       monitor the same way but keeps the window in the Normal layer.

       All audio apps (Audacious above, Gajim, the DAWs below, and
       Max 9) carry <desktop>2</desktop> so this session boots into
       the Internet workspace (desk 1) but every auto-launched audio
       app lands on the Audio workspace (desk 2).  The user can hop
       between them with W-1 / W-2 / W-Tab.

       force="yes" overrides the app's saved geometry, which otherwise
       maps onto the portrait DP-2 (Renoise is the known case).  The
       point 3406x882 is the CENTER of DP-4's rectangle (DP-4 pos
       2446x342, size 1920x1080 -> center 2446+960, 342+540), strictly
       inside DP-4, so Openbox finds DP-4 from the point alone and
       maximizes on that monitor.

       WM_CLASS class fields: Renoise and sunvox are confirmed live
       (sunvox is lowercase).  Bitwig's comes from its .desktop
       StartupWMClass=com.bitwig.BitwigStudio.  Max 9 is a Wine app;
       its .desktop StartupWMClass=max.exe; Wine typically sets
       WM_CLASS to the .exe name, so class="max.exe" is the best
       guess.

       Bitwig writes WM_CLASS as a single null-terminated string
       (no separate res_class token; xprop shows
       WM_CLASS(STRING) = "com.bitwig.BitwigStudio" with no
       trailing instance/class pair).  Openbox's class= match is
       case-sensitive against res_class, which is empty for
       Bitwig, so the rule would never fire and Bitwig always
       landed on the Internet workspace.  Match by name= instead
       (res_name/instance, the only half Bitwig actually sets).
       Verified live; same fix in music-kiosk-staging/rc.xml. -->
  <application class="Renoise" type="normal">
    <decor>no</decor>
    <maximized>yes</maximized>
    <desktop>2</desktop>
    <position force="yes">
      <x>3406</x>
      <y>882</y>
    </position>
  </application>
  <application name="com.bitwig.BitwigStudio" type="normal">
    <decor>no</decor>
    <maximized>yes</maximized>
    <desktop>2</desktop>
    <position force="yes">
      <x>3406</x>
      <y>882</y>
    </position>
  </application>

  <!-- Gajim (chat): lands on Audio so it doesn't clutter the Internet
       workspace this session boots into.  WM_CLASS "gajim" matches
       both the main window and the chat windows. -->
  <application class="gajim" type="normal">
    <desktop>2</desktop>
  </application>

  <!-- SunVox: windowed (its own settings disable fullscreen),
       placed on DP-4 top-left.  <position><x><y> sets the
       window's TOP-LEFT corner, not its center, so 3406x882
       (DP-4 center) pushed the window past the bottom-right
       edge.  2456x352 = DP-4 origin (2446x342) + 10px margin.
       decor=yes so the user can move/resize the windowed app.

       SunVox's SunDog engine writes an off-screen "user
       specified location" into WM_NORMAL_HINTS at startup and
       XMoveWindow's itself there shortly after mapping, which
       beats this <position force="yes"> rule (force only
       applies once, on initial placement).  sunvox-fix.py
       re-positions the window for the first few seconds after
       launch.  Leave this rule in place so the first paint
       and the watcher's first read both land on DP-4. -->
  <application class="sunvox" type="normal">
    <decor>yes</decor>
    <desktop>2</desktop>
    <position force="yes">
      <x>2456</x>
      <y>352</y>
    </position>
  </application>

  <application class="max.exe" type="normal">
    <decor>yes</decor>
    <desktop>2</desktop>
  </application>

  <!-- xclock (clock-pop, bound W-t): centered on the primary
       monitor.  clock-pop hard-codes xclock -geometry 260x80-40-60
       which pins it to HDMI-0's bottom-left; this rule overrides
       that initial geometry and re-centers the window on DP-4
       (1920x1080 at +2446+342).  force="yes" is required so
       Openbox repositions the window after the WM honors the
       -geometry hint on first map. -->
  <application class="XClock" type="normal">
    <decor>yes</decor>
    <position force="yes">
      <x>center</x>
      <y>center</y>
      <monitor>DP-4</monitor>
    </position>
  </application>

  <!-- Plugin editors and dialogs: floating, decorated, draggable.
       <layer>above</layer> keeps these visible over a maximized
       DAW on DP-4: maximized Normal-layer windows stack above
       other Normal-layer windows in Openbox, so without this a
       zenity logout dialog (or any plugin alert / file picker)
       could map behind the DAW. -->
  <application name="*" type="dialog">
    <decor>yes</decor>
    <fullscreen>no</fullscreen>
    <layer>above</layer>
  </application>
  <application name="*" type="utility">
    <decor>yes</decor>
    <fullscreen>no</fullscreen>
    <layer>above</layer>
  </application>
</applications>

</openbox_config>