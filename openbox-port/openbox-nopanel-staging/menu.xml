  <!-- Fluxbox's [stylesdir] browser has no Openbox equivalent - Openbox
       themes are a different format (~/.themes), picked once via rc.xml's
       <theme><name>, not browsed live from a Fluxbox styles/ directory.
       Dropped both [stylesdir] entries; kept the WM-agnostic GTK item. -->
  <menu id="themes-menu" label="Themes">
    <item label="GTK and icons…"><action name="Execute"><command>xfce4-appearance-settings</command></action></item>
  </menu>

  <!-- Panel: this session has no tint2, only `plank -n nopanel` as its
       dock.  "Kill plank" drops the dock for the rest of the session
       (Plank has an autorestart loop, so it will come back at next
       Openbox No Panel login).  "Start plank" is a re-launch for the
       current session in case the kill command above ever leaves it
       dead for some reason.  References by name so this never
       accidentally targets a `plank -n music` / `plank -n kiosk` from
       a previous session. -->
  <menu id="panel-menu" label="Panel">
    <item label="Kill plank"><action name="Execute"><command>pkill -f 'plank -n nopanel'</command></action></item>
    <item label="Start plank"><action name="Execute"><command>plank -n nopanel</command></action></item>
    <separator/>
    <item label="Kill tint2 (if stale)"><action name="Execute"><command>pkill -x tint2</command></action></item>
  </menu>

