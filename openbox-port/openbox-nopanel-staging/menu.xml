<!--
  Openbox root-menu / workspace-menu for the Openbox No Panel session
  (logged in via /usr/local/bin/openbox-nopanel).  Same content as the
  Openbox Music session's menu.xml, minus the Panel submenu (this
  session has no tint2 and no panel-size.sh to toggle).  Icons are
  referenced in place from ~/.fluxbox/pixmaps (not copied) - see
  openbox-port/PORT-NOTES.md for why that directory is fine to leave
  there.
-->
<openbox_menu xmlns="http://openbox.org/3.4/menu">

<!-- rc.xml's OnDesktop/Root Mouse2 (:WorkspaceMenu) has no built-in Openbox
     generator (no [workspaces]-equivalent tag), so this is a small static
     menu instead. Fine because desktop count/names are now static in
     rc.xml's <desktops> rather than something users add/remove at runtime. -->
